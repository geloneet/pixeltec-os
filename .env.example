# Assets publicos (URLs heredadas en Firebase Storage; migrar a R2 es gate aparte - ver B9)
NEXT_PUBLIC_LOGO_URL=https://firebasestorage.googleapis.com/v0/b/studio-1487114664-78b63.firebasestorage.app/o/ptlogo2.png?alt=media
NEXT_PUBLIC_PROFILE_PHOTO_URL=https://firebasestorage.googleapis.com/v0/b/studio-1487114664-78b63.firebasestorage.app/o/fotodeperfil.jpg?alt=media

# URL del vps-api (infra DevOps). Default: https://api.pixeltec.mx
VPS_API_URL=https://api.pixeltec.mx
# Secret compartido con el vps-api (dual-secret activo durante migración)
CRON_SECRET=change-me-use-a-strong-random-string

# ── Public funnel (contact form + newsletter) ─────────────────────────────────
# Resend transactional email
RESEND_API_KEY=re_change_me
RESEND_FROM_EMAIL=PixelTEC <noreply@pixeltec.mx>
PIXELTEC_TEAM_EMAIL=contacto@pixeltec.mx
# Opaque salt used to hash visitor IPs before persisting them
# (GDPR Art. 4(1) — raw IP is PII). 32+ random chars.
# Generate with:  openssl rand -base64 48
INTERNAL_IP_SALT=change-me-use-a-32-plus-char-random-string

# ── Anthropic (Blog AI Pipeline) ──────────────────────────────────────────────
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Model used for blog draft generation
ANTHROPIC_MODEL=claude-opus-4-7

# ── App URL ───────────────────────────────────────────────────────────────────
# Production: https://pixeltec.mx  |  Dev: https://dev.pixeltec.mx
NEXT_PUBLIC_APP_URL=https://pixeltec.mx

# ── Meta / Facebook OAuth (Growth Suite — Publisher) ──────────────────────────
# Create app at https://developers.facebook.com → type Business
# Products: Facebook Login for Business + Instagram
# Valid OAuth redirect URIs: https://pixeltec.mx/api/auth/meta/callback
#                            https://dev.pixeltec.mx/api/auth/meta/callback
META_APP_ID=
META_APP_SECRET=

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
# Replaces Twilio for all outbound WhatsApp. Get these from
# https://developers.facebook.com/apps/<APP_ID>/whatsapp-business/
WHATSAPP_ACCESS_TOKEN=                    # System User access token
WHATSAPP_PHONE_NUMBER_ID=                 # Phone Number ID
WHATSAPP_DEFAULT_TO=                       # Default recipient, ej 5213221378336
# WABA ID (WhatsApp Business Account). Opcional para ENVIAR; obligatorio para la
# superficie de GESTIÓN de /whatsapp (WO-2026-00181): sin él,
# GET /api/whatsapp-inbox/account y /templates responden 200 con
# `configured:false` en vez de fallar. Se lee en la misma pantalla de Meta que
# el Phone Number ID.
WHATSAPP_BUSINESS_ACCOUNT_ID=              # Optional (requerido para gestión)
WHATSAPP_API_VERSION=v21.0         # Optional, defaults to v21.0
# Solo para el smoke local con un mock de Graph API. Se IGNORA en producción y
# se ignora si no es loopback (localhost / 127.0.0.1 / ::1): el token de Meta
# nunca debe salir hacia un host ajeno por un .env mal copiado.
WHATSAPP_GRAPH_BASE_URL=                   # Optional, ej http://127.0.0.1:9099

# ── PixelBot WhatsApp Inbox ──────────────────────────────────────────
# URL interna del bot. Producción (Docker web-network): http://pixelbot:3011
# Dev local en el VPS: http://127.0.0.1:3011
PIXELBOT_INTERNAL_URL=http://pixelbot:3011
# Mismo valor que INTERNAL_API_SECRET en el .env.production de pixelbot.
# Generar con: openssl rand -hex 32
PIXELBOT_INTERNAL_SECRET=change-me-use-a-32-plus-char-random-string
# ID del tenant en SQLite del bot:
# docker exec pixelbot python3 -c "import sqlite3; print(sqlite3.connect('/app/data/agentkit.db').execute('SELECT id, slug FROM tenants').fetchall())"
PIXELBOT_TENANT_ID=

# ── R2 (Cloudflare) — almacenamiento de archivos (avatares, portadas de blog) ──
# Bucket S3-compatible. Ver https://developers.cloudflare.com/r2/api/s3/tokens/
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change_me
R2_SECRET_ACCESS_KEY=change_me
R2_BUCKET_NAME=pixeltec-<proyecto>-prod
R2_PUBLIC_URL=https://<dominio-publico-o-r2.dev>

# ── Unsplash (búsqueda de portadas en el editor de blog) ──────────────────────
# Solo lectura de un catálogo público. Get your key at https://unsplash.com/oauth/applications
# Opcional: sin ella, el buscador de portadas del editor queda inactivo.
UNSPLASH_ACCESS_KEY=change_me

# ── Google Search Console (módulo SEO & Contenido, WO-2026-00214) ─────────────
# Solo LECTURA de las métricas de nuestra propia propiedad. Opcional: sin estas
# variables el cron `api/cron/seo-gsc-sync` no sincroniza nada y la pantalla
# /seo/contenido muestra "Search Console aún no conectado" — nunca un cero
# inventado.
#
# GOOGLE_SERVICE_ACCOUNT_JSON va en BASE64 del JSON completo de la cuenta de
# servicio: la clave privada lleva saltos de línea reales y pegarla cruda aquí
# la parte en el primer \n. Generar con:
#   base64 -i ruta/a/service-account.json | tr -d '\n'
# La cuenta de servicio necesita permiso de lectura sobre la propiedad en
# Search Console (Configuración → Usuarios y permisos → añadir su client_email).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Propiedad de DOMINIO (cubre http/https, www y subdominios en una sola).
GSC_SITE_URL=sc-domain:pixeltec.mx

# ══════════════════════════════════════════════════════════════════════════════
# ## Política de egress E0 — fail-closed
# ══════════════════════════════════════════════════════════════════════════════
# Contrato completo de las 28 variables de POLÍTICA de la cadena E0. Ninguna
# contiene secretos (las credenciales viven arriba, en sus secciones).
#
# Reglas globales de los guards (src/lib/egress-guard.ts, src/lib/cron-guard.ts):
#   - Modos válidos por canal: disabled | allowlist | live
#   - Variable de modo AUSENTE  → el canal queda disabled (fail-closed).
#   - Valor INVÁLIDO            → bloqueo (no degrada al default).
#   - live fuera de producción  → bloqueado, salvo el flag explícito global.
#   - allowlist vacía           → bloqueo.
#   - Flags booleanos: únicamente "true" (trim + lowercase) autoriza; "false",
#     vacío o cualquier otro valor NO activan nada. En producción los flags
#     *_OUTSIDE_PRODUCTION deben permanecer AUSENTES, no puestos en false.
# Validador local: npm run validate:egress  (scripts/validate-egress-config.ts)

# ── 1. Global ─────────────────────────────────────────────────────────────────
# Fallback OPCIONAL para canales sin modo propio. NO usarla en producción como
# atajo: producción declara cada canal explícitamente (una variable por canal).
# EGRESS_DEFAULT_MODE=disabled
# PROHIBIDA EN PRODUCCIÓN. Permite modo live fuera de producción. Solo "true"
# activa la excepción; en producción debe permanecer ausente.
EGRESS_ALLOW_LIVE_OUTSIDE_PRODUCTION=

# ── 2. Email (Resend) ─────────────────────────────────────────────────────────
# OBLIGATORIA EN PRODUCCIÓN. Sin ella no sale ningún correo.
EGRESS_EMAIL_MODE=disabled
# Destinatarios permitidos (CSV) — se usa cuando el modo es allowlist.
EGRESS_EMAIL_ALLOWLIST=equipo@example.test

# ── 3. WhatsApp (Cloud API) ───────────────────────────────────────────────────
# OBLIGATORIA EN PRODUCCIÓN.
EGRESS_WHATSAPP_MODE=disabled
# Números permitidos (CSV) — se usa cuando el modo es allowlist.
EGRESS_WHATSAPP_ALLOWLIST=+5210000000000

# ── 4. VPS (vps-api) ──────────────────────────────────────────────────────────
# OBLIGATORIA EN PRODUCCIÓN.
EGRESS_VPS_MODE=disabled
# Hostnames permitidos (CSV) — se usa cuando el modo es allowlist.
EGRESS_VPS_HOST_ALLOWLIST=vps.example.test

# ── 5. R2 (Cloudflare) ────────────────────────────────────────────────────────
# OBLIGATORIA EN PRODUCCIÓN.
EGRESS_R2_MODE=disabled
# Buckets permitidos (CSV) — se usa cuando el modo es allowlist.
EGRESS_R2_BUCKET_ALLOWLIST=pixeltec-example-dev
# CAPACIDAD CONDICIONAL (mínimo privilegio): ausente = borrados bloqueados.
# Activar R2 NO la exige — ponla en "true" únicamente si este despliegue
# necesita borrar objetos (p.ej. reemplazo de avatar).
EGRESS_R2_ALLOW_DELETE=
# Red de seguridad, NO credencial: buckets de producción inalcanzables desde
# otros entornos aunque alguien los añada a una allowlist.
EGRESS_R2_PRODUCTION_BUCKETS=

# ── 5b. Unsplash (búsqueda de portadas — editor de blog) ──────────────────────
# OPCIONAL: canal opcional del contrato E0 (validate-egress-config.ts lo marca
# `optional: true`) — ausente o "disabled" simplemente desactiva el buscador de
# portadas, no bloquea el arranque de la app. Sin allowlist propia (solo modo).
EGRESS_UNSPLASH_MODE=disabled

# ── 5c. Google Search Console (módulo SEO & Contenido) ────────────────────────
# OPCIONAL: canal opcional del contrato E0 (validate-egress-config.ts lo marca
# `optional: true`) — ausente o "disabled" desactiva la sincronización de
# Search Console, no bloquea el arranque. Sin allowlist propia (solo modo): el
# host es fijo (searchconsole.googleapis.com) y la única operación es `read`
# sobre nuestra propia propiedad. Requiere GOOGLE_SERVICE_ACCOUNT_JSON +
# GSC_SITE_URL (arriba, sección de credenciales).
EGRESS_GOOGLE_MODE=disabled

# ── 6. Meta (Graph API — Growth Publisher) ────────────────────────────────────
# OBLIGATORIA EN PRODUCCIÓN.
EGRESS_META_MODE=disabled
# Apps y cuentas permitidas (CSV) — se usan cuando el modo es allowlist.
EGRESS_META_APP_ALLOWLIST=app_example
EGRESS_META_ACCOUNT_ALLOWLIST=account_example
# CAPACIDADES CONDICIONALES (mínimo privilegio): ausentes = bloqueadas.
# Activar Meta NO las exige — "true" únicamente si este despliegue necesita
# leer credenciales o publicar contenido real, respectivamente.
EGRESS_META_ALLOW_CREDENTIAL_READ=
EGRESS_META_ALLOW_PUBLISH=
# Redes de seguridad, NO credenciales: identidades de producción inalcanzables
# desde otros entornos.
EGRESS_META_PRODUCTION_APP_IDS=
EGRESS_META_PRODUCTION_ACCOUNT_IDS=

# ── 7. IA (Anthropic / OpenAI / Ideogram / fal) ───────────────────────────────
# OBLIGATORIA EN PRODUCCIÓN.
EGRESS_AI_MODE=disabled
# OBLIGATORIA EN PRODUCCIÓN. Pares proveedor:modelo (CSV). Se exige SIEMPRE,
# también con el canal en live — sin lista no hay ninguna llamada de IA.
EGRESS_AI_TARGET_ALLOWLIST=anthropic:model-example,openai:model-example,ideogram:model-example,fal:model-example
# PROHIBIDA EN PRODUCCIÓN. Permite mandar input real a la IA fuera de
# producción. Solo "true" activa; en producción debe permanecer ausente.
EGRESS_AI_ALLOW_INPUT_OUTSIDE_PRODUCTION=

# ── 8. PixelBot (canal interno — WhatsApp Inbox, E0e) ─────────────────────────
# FAIL-CLOSED: sin EGRESS_INTERNAL_MODE y EGRESS_INTERNAL_TARGET_ALLOWLIST
# el inbox de WhatsApp entero deja de funcionar. Ponerlas en el VPS ANTES
# de desplegar, no después. OBLIGATORIAS EN PRODUCCIÓN.
EGRESS_INTERNAL_MODE=allowlist
# Destinos exactos <servicio>:<host>:<puerto>, separados por coma. La lista
# se exige SIEMPRE, también en modo live. Dev local: pixelbot:127.0.0.1:3011
EGRESS_INTERNAL_TARGET_ALLOWLIST=pixelbot:127.0.0.1:3011
# PROHIBIDA EN PRODUCCIÓN. Enviar un WhatsApp real a un cliente desde fuera de
# producción exige este reconocimiento aparte: leer configuración y escribirle
# a una persona no comparten perfil de riesgo. Solo "true" autoriza.
EGRESS_INTERNAL_ALLOW_SEND_OUTSIDE_PRODUCTION=

# ── 9. Cron ───────────────────────────────────────────────────────────────────
# OBLIGATORIA EN PRODUCCIÓN. Modos: disabled | enabled (ausente → disabled;
# inválido → bloqueo). Las rutas cron exigen además CRON_SECRET (sección de
# secretos, arriba) — ese es secreto operativo, no política.
CRON_EXECUTION_MODE=disabled
# PROHIBIDA EN PRODUCCIÓN. Ejecutar cron fuera de producción. Solo "true"
# activa; en producción debe permanecer ausente.
CRON_ALLOW_OUTSIDE_PRODUCTION=

# ── 10. Verificación en dos pasos (C-PR4) ─────────────────────────────────────
# Clave AES-256-GCM para cifrar los secretos TOTP en `user_mfa.secret_enc`.
# 32 bytes en base64: genera con `openssl rand -base64 32`. NO es necesaria
# para arrancar la app — solo falla (con mensaje claro) al ENROLAR 2FA o al
# validar un login de una cuenta con 2FA ya activa. Rotarla invalida los
# secretos ya cifrados (los usuarios tendrían que re-enrolar; break-glass en
# drizzle/0033_user_mfa.sql).
MFA_ENCRYPTION_KEY=
# Futuro hard-enforce de 2FA para cuentas admin. HOY NO SE LEE en código:
# el soft-enforce actual es solo un aviso en /perfil para admins sin 2FA.
# Documentada aquí para reservar el nombre y el contrato ("true" activará el
# bloqueo cuando se implemente).
MFA_REQUIRED_FOR_ADMINS=
